# Application Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
# Local instance or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/food_quality_db

# Machine Learning Service (Python FastAPI)
ML_BASE_URL=http://127.0.0.1:8000
ML_REQUEST_TIMEOUT_MS=10000

# CORS Configuration (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PREDICTIONS=30
