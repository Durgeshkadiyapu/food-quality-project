# Copy to .env and start with:  uvicorn app.main:app --env-file .env --port 8000
MODELS_DIR=models
DEFAULT_TRAINING_MODE=proxy_real
# Comma-separated. Restrict to your React dev/prod origins before deploying.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_BATCH_SIZE=500
# Optional: dataset path for the training scripts (otherwise data/raw/food_quality_master_expanded_transparent.csv)
# FOOD_QUALITY_DATASET=C:\path\to\food_quality_master_expanded_transparent.csv
